// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  super_admin
  admin
  user
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  full_name    String
  password     String
  phone_number String
  type         UserType @default(user)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  groups              Group[]
  deletedGroups       Group[]               @relation("DeletedGroups")
  groupMembers        GroupMember[]
  deletedGroupMembers GroupMember[]         @relation("DeletedGroupMembers")
  groupMemberPayments GroupMemberPayment[]
  deletedGroupMemberPayments GroupMemberPayment[] @relation("DeletedGroupMemberPayments")

  sentGroupMessages   GroupMessage[]        @relation("GroupMessageSender")
  groupChatReads      GroupChatRead[]

  notifications       Notification[]

  @@map("users")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  date        DateTime @db.Date
  is_finished Boolean  @default(false)
  price       Decimal? @db.Decimal(10, 2)
  currency_id Int?
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  Int?

  creator       User           @relation(fields: [created_by], references: [id])
  deleter       User?          @relation("DeletedGroups", fields: [deleted_by], references: [id])
  currency      Currency?      @relation(fields: [currency_id], references: [id])
  groupMember   GroupMember[]
  groupExpenses GroupExpense[]
  messages      GroupMessage[]
  chatReads     GroupChatRead[]

  @@map("groups")
}

enum PaxType {
  A
  C
  I
}

enum Gender {
  male
  female
}

model GroupMember {
  id             Int       @id @default(autoincrement())
  group_id       Int
  first_name     String
  last_name      String
  pax_type       PaxType   @default(A)
  nationality    String?
  passport       String?
  date_of_birth  DateTime? @db.Date
  gender         Gender?
  date_of_expiry DateTime? @db.Date
  comment        String?
  file_path      String?
  created_by     Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  is_deleted     Boolean   @default(false)
  deleted_by     Int?

  group    Group                @relation(fields: [group_id], references: [id])
  creator  User                 @relation(fields: [created_by], references: [id])
  deleter  User?                @relation("DeletedGroupMembers", fields: [deleted_by], references: [id])
  payments GroupMemberPayment[]

  @@map("group_members")
}

model Currency {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  symbol          String   @unique
  country         String   @unique
  is_main         Boolean  @default(false)
  currency_change Decimal  @default(1) @db.Decimal(20, 5)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  expenses            Expense[]
  groups              Group[]
  groupMemberPayments GroupMemberPayment[]
  mainForGroupMemberPayments GroupMemberPayment[] @relation("MainCurrencyForPayments")

  @@unique([symbol, code, country])
  @@map("currencies")
}

model Expense {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  currency_id Int
  value       Decimal  @db.Decimal(10, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  currency      Currency       @relation(fields: [currency_id], references: [id])
  groupExpenses GroupExpense[]

  @@map("expenses")
}

model GroupExpense {
  id         Int     @id @default(autoincrement())
  group_id   Int
  expense_id Int
  value      Decimal @db.Decimal(10, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group   Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expense_id], references: [id])

  @@map("group_expenses")
}

model GroupMessage {
  id         Int      @id @default(autoincrement())
  group_id   Int
  sender_id  Int
  content    String?
  file_path  String?
  created_at DateTime @default(now())

  group  Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  sender User  @relation("GroupMessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at])
  @@map("group_messages")
}

model GroupChatRead {
  id         Int      @id @default(autoincrement())
  group_id   Int
  user_id    Int
  last_read_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("group_chat_reads")
}

enum NotificationType {
  MESSAGE_NEW
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  type       NotificationType
  title      String
  body       String?
  data       Json?
  read_at    DateTime?
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("notifications")
}

model GroupMemberPayment {
  id               Int       @id @default(autoincrement())
  group_member_id  Int
  payment          Decimal   @db.Decimal(10, 2)
  original_payment Decimal   @db.Decimal(10, 2)
  currency_id      Int?
  currency_rate    Decimal   @default(1) @db.Decimal(20, 5)
  main_currency_id Int?
  created_by       Int
  deleted_by       Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  groupMember  GroupMember @relation(fields: [group_member_id], references: [id], onDelete: Cascade)
  currency     Currency?   @relation(fields: [currency_id], references: [id])
  mainCurrency Currency?   @relation("MainCurrencyForPayments", fields: [main_currency_id], references: [id])
  creator      User        @relation(fields: [created_by], references: [id])
  deleter      User?       @relation("DeletedGroupMemberPayments", fields: [deleted_by], references: [id])

  @@map("group_member_payments")
}
